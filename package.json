    "lighthouse": "lighthouse http://localhost:3000 --view --output=html --output-path=./lighthouse-report.html",
    "seo:test": "npm run build && echo 'Build successful - ready for SEO testing'",
    "deploy:check": "npm run lint && npm run build && echo 'Ready for deployment!'"
  },
  "dependencies": {
    "eslint": "^9.24.0",
    "eslint-config-next": "15.1.6",
    "next": "15.3.8",
