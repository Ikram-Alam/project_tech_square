    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.3",
    "postcss": "^8.5.3",
    "@tailwindcss/postcss": "^4.1.3",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "^10.4.17",
