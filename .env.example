# Production Environment Variables for techsquare.com
# Copy this file to .env.local and fill in your actual values

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (replace with your actual verification code)
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Microsoft Bing Webmaster Tools
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code

# Yandex Webmaster Tools
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://techsquare.com
NEXT_PUBLIC_SITE_NAME="Tech Square"

# Business Information
NEXT_PUBLIC_BUSINESS_PHONE=+923313587093
NEXT_PUBLIC_BUSINESS_EMAIL=techsquare.corp@gmail.com
NEXT_PUBLIC_BUSINESS_ADDRESS="Karachi, Pakistan"

# Social Media (optional)
NEXT_PUBLIC_TWITTER_HANDLE=@TechSquare
NEXT_PUBLIC_FACEBOOK_PAGE=https://facebook.com/techsquare
NEXT_PUBLIC_LINKEDIN_PAGE=https://linkedin.com/company/techsquare

# Performance Monitoring (optional)
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id
NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# Build Configuration
ANALYZE=false
NODE_ENV=production